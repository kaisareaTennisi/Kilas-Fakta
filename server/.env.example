# ===== KILASFAKTA SERVER ENV =====

# Port server
PORT=5000

# Environment: development | production
NODE_ENV=development

# URL frontend (untuk CORS whitelist)
CLIENT_URL=http://localhost:5173

# ===== DATABASE (PostgreSQL) =====
# Contoh koneksi lokal: postgres://user:password@localhost:5432/kilasfakta
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kilasfakta

# Alternatif bila ingin memecah bagian-bagian koneksi:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=kilasfakta
# DB_USER=postgres
# DB_PASSWORD=postgres

# ===== JWT =====
# Gunakan string acak yang panjang (min 32 karakter)
JWT_SECRET=ganti-dengan-secret-panjang-acak-32-karakter-minimal
JWT_EXPIRES_IN=7d

# ===== NEWS API (pilih salah satu) =====
# 1) NewsAPI.org  -> https://newsapi.org
NEWS_API_KEY=https://newsapi.org
# 2) Currents API -> https://currentsapi.services (fallback)
CURRENTS_API_KEY=https://currentsapi.services

# ===== GOOGLE AI (Gemini) =====
# Ambil dari Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-1.5-flash

# ===== GOOGLE OAUTH =====
# Client ID dari Google Cloud Console (sama dengan VITE_GOOGLE_CLIENT_ID di frontend)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
